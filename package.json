{
  "name": "z-biz-tool-music",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "description": "MuseLab 音乐工坊：一句话到一首曲——五线谱/简谱/钢琴卷帘同步编辑，多音色混音，AI 作曲",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "tauri": "tauri",
    "build:dmg": "tauri build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tonejs/midi": "^2.0.28",
    "abcjs": "^6.7.2",
    "antd": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tone": "^15.1.22",
    "z-biz-tool-shared": "^0.1.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
